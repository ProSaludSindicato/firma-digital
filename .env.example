# Copiar a `.env` y rellenar. El archivo `.env` está en .gitignore.

# --- Frontend (Vite: solo variables con prefijo VITE_ llegan al cliente) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# API backend ProSalud (Laravel) — metadata/PDF/submit por token.
# Local con Herd/Valet: https://prosalud.test/api
# Prueba desde celular/red: php artisan serve --host=0.0.0.0 --port=8001 en prosalud
#   y usar http://TU_IP_LOCAL:8001/api
VITE_PROSALUD_API_URL=https://prosalud.test/api

# --- Servidor de firma automática (Node: `server/index.ts`) ---
# Puerto del servicio HTTP local (por defecto 3001).
AUTO_SIGN_PORT=3001
# Nivel de log del logger (p. ej. info, warn, error).
LOG_LEVEL=info
# Clave compartida para autenticar peticiones al endpoint de firma automática.
AUTO_SIGN_API_KEY=replace-with-a-long-random-secret
