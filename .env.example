# Copiar a `.env` y rellenar. El archivo `.env` está en .gitignore.

# --- Frontend (Vite: solo variables con prefijo VITE_ llegan al cliente) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# API backend ProSalud (Laravel) — metadata/PDF/submit por token.
# Local con Vite: /api (mismo origen; Vite reenvía a PROSALUD_API_PROXY_TARGET).
# Producción: URL absoluta, p. ej. https://prosalud.org.co/api
VITE_PROSALUD_API_URL=/api
PROSALUD_API_PROXY_TARGET=https://prosalud.test

# Portal público ProSalud (SPA) para enlaces legales compartibles.
# Ej.: https://www.prosalud.org.co
VITE_PROSALUD_PORTAL_URL=https://www.prosalud.org.co

# Herramientas sin token: `/` (firma pública) y `/editor`.
# true = habilitadas. Ausente o false = solo flujos por enlace (ProSalud prod).
VITE_PUBLIC_TOOLS_ENABLED=false

# --- Servidor de firma automática (Node: `server/index.ts` / Docker en Contabo) ---
# En el VPS basta con estas tres variables. El frontend (VITE_*) no se despliega ahí.
# Puerto interno del contenedor (no cambiar si usas docker-compose tal cual).
AUTO_SIGN_PORT=3001
# Nivel de log del logger (p. ej. info, warn, error).
LOG_LEVEL=info
# Obligatorio en producción — generar con: openssl rand -hex 32
# Laravel debe enviar el mismo valor en el header X-Api-Key.
AUTO_SIGN_API_KEY=replace-with-a-long-random-secret
# Opcional: path absoluto al worker de pdfjs. Docker Compose lo define solo.
# PDFJS_WORKER_SRC=/app/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs
